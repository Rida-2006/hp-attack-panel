# Reference only: set variables in PowerShell; this file is not auto-loaded.
HONEYPOT_URL=http://127.0.0.1:8080
# Tripwires use this origin with their fixed catalogue routes/queries.
# Connectivity checks use the exact endpoint; unrelated query inputs are not inherited by tripwires.
TEST_TARGET_URL=http://127.0.0.1:8080
TEST_REQUEST_TIMEOUT=10
HONEYPOT_NAME=Local Python deception sink
HONEYPOT_ALLOWED_HOSTS=localhost,127.0.0.1,::1
PANEL_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
# Optional: PANEL_DB_PATH defaults to data/panel.sqlite3
# Keep VITE_DEMO_MODE unset/false for real HTTP tests.
# Optional private Tailscale Serve hostname (no scheme); use loopback-only
# Uvicorn with --no-proxy-headers and its https origin in PANEL_ORIGINS.
# PANEL_TAILSCALE_HOST=your-device.your-tailnet.ts.net
# WIREGUARD_SERVICE_NAME=WireGuardTunnel$wg2
